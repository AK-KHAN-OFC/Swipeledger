# ─────────────────────────────────────────────────────────────────────────────
# SwipeLedger — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=10000

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (or local URI for development)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb://localhost:27017/swipeledger

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 random characters. Never reuse across environments.
JWT_SECRET=replace-with-a-cryptographically-random-256-bit-hex-string

# Access token lifetime (e.g. 60m, 2h, 1d)
JWT_EXPIRY=60m

# ── Refresh Tokens ───────────────────────────────────────────────────────────
# Refresh token cookie lifetime in days
REFRESH_TOKEN_EXPIRY_DAYS=30

# ── Auth ─────────────────────────────────────────────────────────────────────
# bcrypt cost factor — 12 for production, 4 acceptable for development
BCRYPT_ROUNDS=12

# ── Devices ──────────────────────────────────────────────────────────────────
DEFAULT_DEVICE_LIMIT=3

# ── CORS ─────────────────────────────────────────────────────────────────────
# Exact origin of the frontend — no trailing slash
CLIENT_ORIGIN=http://localhost:5173

# ── Frontend (Vite build-time) ────────────────────────────────────────────────
# URL of the backend API, used by the React client at build time.
# Development: leave empty or use /api/v1 (Vite proxy handles it)
# Production:  set to your Render backend URL, e.g. https://swipeledger-api.onrender.com/api/v1
# IMPORTANT: must never contain secrets — this value is bundled into the frontend JS.
VITE_API_URL=/api/v1

# ── Logging ──────────────────────────────────────────────────────────────────
# Levels: error | warn | info | http | verbose | debug
LOG_LEVEL=http

# ── Seed Script ──────────────────────────────────────────────────────────────
# Credentials for the initial account created by the seed script.
# Used in development only — never use these in production without changing them.
SEED_BUSINESS_NAME=My Business
SEED_USERNAME=admin
SEED_PASSWORD=changeme123
