# ── Production environment variables (baked into the Vite bundle at build time) ──
# This file is intentionally committed — it contains NO secrets.
# VITE_* variables are public and visible in the compiled JS bundle.

# Backend API base URL — points to the live Render service.
# The client's axios instance reads this at build time:
#   const BASE_URL = import.meta.env.VITE_API_URL || '/api/v1';
VITE_API_URL=https://swipeledger.onrender.com/api/v1
