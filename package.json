{
  "name": "swipeledger",
  "version": "1.0.0",
  "private": true,
  "description": "SwipeLedger — Professional transaction and customer management",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "seed": "node server/scripts/seed.js",
    "generate-lockfiles": "npm install && npm install --prefix server && npm install --prefix client",
    "test": "jest --config tests/jest.config.js --runInBand",
    "test:unit": "jest --config tests/jest.config.js --testPathPattern=tests/unit --runInBand",
    "test:integration": "jest --config tests/jest.config.js --testPathPattern=tests/integration --runInBand",
    "test:security": "jest --config tests/jest.config.js --testPathPattern=tests/security --runInBand",
    "test:coverage": "jest --config tests/jest.config.js --coverage --runInBand"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "mongodb-memory-server": "^10.1.4",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.0.5"
  },
  "mongodbMemoryServer": {
    "version": "7.0.14",
    "arch": "x64"
  }
}
